# Copy to .env (gitignored). Never commit real secrets.
POSTGRES_USER=itsm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=itsm

SCHEDULER_ENABLED=true
SLA_MONITOR_INTERVAL_SECONDS=30
SLA_WARNING_FRACTION=0.2
ESCALATION_AFTER_MINUTES={"P1": 5, "P2": 15}
AUTO_CLOSE_DAYS=3

EMBEDDER_BACKEND=minilm
DUP_THRESHOLD=0.75
CAT_MIN_CONFIDENCE=0.5
SEED_ON_START=false

# PENDING_P2: JWT_SECRET, CORS_ORIGINS ...   PENDING_P3: SMTP_HOST, SMTP_USER, SMTP_PASSWORD ...
