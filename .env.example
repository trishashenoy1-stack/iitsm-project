# Copy to .env (gitignored). Never commit real secrets.
POSTGRES_USER=itsm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=itsm

SCHEDULER_ENABLED=true
SLA_MONITOR_INTERVAL_SECONDS=30
SLA_WARNING_FRACTION=0.2
ESCALATION_AFTER_MINUTES={"P1": 5, "P2": 15}
AUTO_CLOSE_DAYS=3

EMBEDDER_BACKEND=minilm
DUP_THRESHOLD=0.47
CAT_MIN_CONFIDENCE=0.5
SEED_ON_START=false

# P2: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
JWT_SECRET=
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=["http://localhost:5173"]
# Password for every seeded demo account (scripts/seed.py). Required when APP_ENV=production.
SEED_PASSWORD=

# P3: email. "simulated" logs instead of sending.
EMAIL_BACKEND=simulated
# SMTP_HOST=  SMTP_PORT=587  SMTP_USERNAME=  SMTP_PASSWORD=  SMTP_SENDER=  SMTP_USE_TLS=true
